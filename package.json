{
  "name": "contextos",
  "version": "0.1.0",
  "description": "Shared memory and decision kernel for Gemini agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
